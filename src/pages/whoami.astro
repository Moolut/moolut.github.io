---
import TVLayout from '../layouts/TVLayout.astro'
import CVSection from '../components/CVSection.astro'
import Badge from '../components/Badge.astro'
import { education, workExperience, skills } from '../modules/cv-data'

// Transform education data for terminal CVSection component
const educationItems = education.map((edu) => ({
  title: edu.institution,
  subtitle: edu.degree,
  period: edu.period,
  location: edu.location,
  gpa: edu.gpa,
  technologies: edu.technologies,
  highlights: edu.highlights,
}))

// Transform work experience data for terminal CVSection component
const workItems = workExperience.map((work) => ({
  title: work.company,
  subtitle: work.position,
  period: work.period,
  location: work.location,
  technologies: work.technologies,
  highlights: work.highlights,
  positions: work.positions,
}))
---

<TVLayout title="whoami">
  <article class="whoami">
    <h1 class="big-text page-title">
      <span class="terminal-prompt">$</span> <span class="whoami-text">WHOAMI</span>
    </h1>

    <nav class="page-nav">
      <a href="#education" class="page-nav__link">Education</a>
      <a href="#work-experience" class="page-nav__link">Work Experience</a>
      <a href="#skills" class="page-nav__link">Tech Skills</a>
      <a href="#languages" class="page-nav__link">Languages</a>
    </nav>
    <!-- Placeholder that fills the nav's space when it is pinned/fixed -->
    <div class="page-nav-spacer" aria-hidden="true"></div>

    <div id="education">
      <CVSection title="Education" items={educationItems} />
    </div>

    <div id="work-experience">
      <CVSection title="Work Experience" items={workItems} />
    </div>

    <section class="terminal-section" id="skills">
      <h2 class="terminal-header">
        <span class="prompt">$</span>
        <span class="command">cat</span>
        <span class="filename">skills_&_technologies.txt</span>
      </h2>
      <div class="terminal-content">
        <div class="skills-grid">
          {Object.entries(skills.technologies).map(([category, items]) => (
            <div class="skill-category">
              <h3 class="skill-category__title">
                <span class="category-prompt">></span> {category}
              </h3>
              <div class="badges">
                {items.map((tech) => <Badge label={tech} />)}
              </div>
            </div>
          ))}
          <div class="skill-category">
            <h3 class="skill-category__title">
              <span class="category-prompt">></span> Skills
            </h3>
            <div class="badges">
              {skills.skills.map((skill) => <Badge label={skill} variant="secondary" />)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="terminal-section" id="languages">
      <h2 class="terminal-header">
        <span class="prompt">$</span>
        <span class="command">cat</span>
        <span class="filename">languages.txt</span>
      </h2>
      <div class="terminal-content">
        <ul class="languages-list">
          {
            skills.languages.map((lang) => {
              const proficiencyMap = {
                'Mother tongue': 100,
                'C1 (Advanced)': 85,
                'B1 (Intermediate)': 60,
              }
              const proficiency = proficiencyMap[lang.level] || 50

              return (
                <li>
                  <div class="lang-header">
                    <span class="lang-prompt">></span>
                    <strong>{lang.name}</strong>
                    <span class="lang-level">{lang.level}</span>
                  </div>
                  <div class="lang-proficiency">
                    <div class="lang-proficiency-fill" style={`width: ${proficiency}%`}></div>
                  </div>
                </li>
              )
            })
          }
        </ul>
      </div>
    </section>
  </article>
</TVLayout>

<style>
  /* Remove glitchy text effect from body content */
  .whoami,
  .whoami * {
    text-shadow: none !important;
  }

  .whoami {
    max-width: 100%;
    width: 100%;
    box-sizing: border-box;
    overflow-wrap: break-word;
  }

  .page-title {
    margin-bottom: 1rem;
  }

  /* Page navigation - switches between normal flow and fixed once the h1 scrolls away */
  .page-nav {
    /* Normal (in-flow) state */
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    z-index: 100;
    background: rgba(0, 0, 0, 0.9);
    border-bottom: 1px solid rgba(0, 255, 0, 0.3);
    padding: 0.5rem 0;
    margin-bottom: 1.5rem;
  }

  /* Pinned state toggled by JS once the page title leaves the viewport */
  .page-nav.is-pinned {
    position: fixed;
    /* top is set dynamically via JS using tv-content's bounding rect */
    left: var(--page-nav-left);
    width: var(--page-nav-width);
    margin-bottom: 0;
  }

  /* Spacer that holds the nav's original height so the layout doesn't jump */
  .page-nav-spacer {
    display: none;
    height: var(--page-nav-height, 0px);
    margin-bottom: 1.5rem;
  }

  .page-nav-spacer.is-visible {
    display: block;
  }

  .page-nav__link {
    font-family: var(--font-primary);
    font-size: clamp(12px, 1.3vw, 14px);
    text-transform: uppercase;
    color: rgba(0, 255, 0, 0.7);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    transition: color 0.2s ease;
    letter-spacing: 0.05em;
    /* Suppress the global rainbow-background effect from content.css */
    background-image: none !important;
  }

  .page-nav__link:hover {
    cursor: var(--cursor-pointer);
    color: #0f0;
  }

  .page-nav__link:focus {
    outline: none;
    color: #0f0;
  }

  .terminal-prompt {
    color: #0f0;
    margin-right: 0.75rem;
    font-weight: bold;
  }

  .whoami-text {
    display: inline-block;
    position: relative;
    color: var(--text-secondary);
    font-weight: bold;
    background-position: center center;
    background-size: 100% 0;
    background-repeat: no-repeat;
    transition: background-size 0.5s cubic-bezier(0.29, 0.8, 0.21, 0.63);
    padding: 0.1em 0.2em;
  }

  html:not(.webp) .whoami-text {
    background-image: url(/assets/images/rainbow-static.gif);
  }

  html.webp .whoami-text {
    background-image: url(/assets/images/rainbow-static.webp);
  }

  .whoami-text.changing {
    background-size: 100% 100%;
    color: transparent;
  }

  /* Offset scroll targets so they aren't hidden behind the pinned nav */
  #education,
  #work-experience,
  #skills,
  #languages {
    scroll-margin-top: 48px;
  }

  .terminal-section {
    margin-bottom: 2rem;
    border: 2px solid var(--text-secondary);
    background: rgba(0, 0, 0, 0.3);
    padding: 0;
    box-shadow: 0 0 20px rgba(0, 255, 0, 0.1);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow-wrap: break-word;
  }

  .terminal-header {
    margin: 0;
    padding: 0.75rem 1.25rem;
    background: linear-gradient(
      to bottom,
      rgba(0, 255, 0, 0.15),
      rgba(0, 255, 0, 0.05)
    );
    border-bottom: 2px solid #0f0;
    font-family: var(--font-primary);
    font-size: clamp(15px, 1.8vw, 20px);
    color: var(--text-secondary);
    font-weight: normal;
    letter-spacing: 0.05em;
  }

  .prompt {
    color: #0f0;
    margin-right: 0.75rem;
    font-weight: bold;
    font-size: 1.1em;
  }

  .command {
    color: #ff0;
    font-weight: bold;
    margin-right: 0.5rem;
  }

  .filename {
    color: var(--text-secondary);
    font-style: italic;
  }

  .terminal-content {
    padding: 1rem;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow-wrap: break-word;
  }

  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .skill-category {
    background: transparent;
    border: none;
    padding: 0;
    border-radius: 0;
    transition: none;
  }

  .skill-category:hover {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .skill-category__title {
    font-family: var(--font-primary);
    font-size: clamp(15px, 1.6vw, 17px);
    text-transform: uppercase;
    margin-bottom: 0.4rem;
    color: var(--text-secondary);
    font-weight: bold;
    position: relative;
    padding-bottom: 0;
  }

  .skill-category__title::after {
    content: none;
  }

  .category-prompt {
    color: #0f0;
    margin-right: 0.5rem;
    font-weight: bold;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
    max-width: 100%;
    align-items: center;
    justify-content: flex-start;
  }

  .languages-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-primary);
  }

  .languages-list li {
    font-size: clamp(16px, 1.8vw, 20px);
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: all 0.3s ease;
    position: relative;
  }

  .languages-list li:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .languages-list li:hover {
    transform: translateX(5px);
  }

  .lang-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lang-prompt {
    color: #0f0;
    font-weight: bold;
  }

  .languages-list strong {
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .lang-level {
    color: rgba(255, 255, 255, 0.6);
    font-size: clamp(14px, 1.6vw, 17px);
  }

  .lang-proficiency {
    width: 100%;
    height: 6px;
    background: rgba(0, 255, 0, 0.1);
    border: 1px solid rgba(0, 255, 0, 0.3);
    border-radius: 2px;
    overflow: hidden;
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: all 0.4s cubic-bezier(0.29, 0.8, 0.21, 0.63);
  }

  .languages-list li:hover .lang-proficiency {
    opacity: 1;
    transform: scaleX(1);
  }

  .lang-proficiency-fill {
    height: 100%;
    background: linear-gradient(90deg, #0f0, #0f0 50%, rgba(0, 255, 0, 0.5));
    box-shadow: 0 0 10px #0f0;
    transition: width 0.6s cubic-bezier(0.29, 0.8, 0.21, 0.63);
  }

  @media (min-width: 768px) {
    /* Grid is now responsive with auto-fit */
  }

  @media (max-width: 768px) {
    .whoami {
      padding: 0 0.5rem;
    }

    .page-nav {
      padding: 0.4rem 0;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .page-nav__link {
      font-size: 11px;
      padding: 0.2rem 0.4rem;
    }

    .page-title {
      margin-bottom: 1rem;
    }

    .terminal-prompt {
      margin-right: 0.4rem;
    }

    .terminal-section {
      margin-bottom: 1.25rem;
      border-width: 1px;
    }

    .terminal-header {
      padding: 0.5rem 0.75rem;
      font-size: 13px;
      letter-spacing: 0.02em;
    }

    .prompt {
      margin-right: 0.4rem;
      font-size: 1em;
    }

    .command {
      margin-right: 0.3rem;
    }

    .filename {
      font-size: 0.95em;
    }

    .terminal-content {
      padding: 0.5rem;
    }

    .skill-category {
      padding: 0;
    }

    .skill-category__title {
      font-size: 14px;
      margin-bottom: 0.3rem;
      padding-bottom: 0;
    }

    .skill-category__title::after {
      content: none;
    }

    .category-prompt {
      margin-right: 0.3rem;
    }

    .badges {
      gap: 0.35rem;
    }

    .skills-grid {
      gap: 0.75rem;
    }

    .languages-list li {
      font-size: 16px;
      margin-bottom: 0.6rem;
      padding-bottom: 0.6rem;
    }

    .lang-header {
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .lang-level {
      font-size: 13px;
    }

    .lang-proficiency {
      height: 5px;
    }
  }

  @media (max-width: 480px) {
    .page-nav {
      display: none;
    }

    .whoami {
      padding: 0 0.35rem;
    }

    .page-title {
      margin-bottom: 1rem;
    }

    .terminal-prompt {
      margin-right: 0.3rem;
    }

    .terminal-section {
      margin-bottom: 0.75rem;
    }

    .terminal-header {
      padding: 0.4rem 0.5rem;
      font-size: 11px;
    }

    .prompt {
      margin-right: 0.25rem;
    }

    .command {
      margin-right: 0.2rem;
    }

    .filename {
      font-size: 0.9em;
    }

    .terminal-content {
      padding: 0.35rem;
    }

    .skill-category {
      padding: 0;
    }

    .skill-category__title {
      font-size: 13px;
      margin-bottom: 0.25rem;
      padding-bottom: 0;
    }

    .skill-category__title::after {
      content: none;
    }

    .category-prompt {
      margin-right: 0.2rem;
    }

    .badges {
      gap: 0.25rem;
    }

    .skills-grid {
      gap: 0.6rem;
    }

    .languages-list li {
      font-size: 14px;
      margin-bottom: 0.4rem;
      padding-bottom: 0.4rem;
    }

    .lang-header {
      gap: 0.3rem;
    }

    .lang-level {
      font-size: 11px;
    }

    .lang-proficiency {
      height: 4px;
    }
  }
</style>

<script>
  // ─── Page nav: pin to top of tv-content once h1 scrolls away ────────────
  function initPageNav() {
    const nav = document.querySelector('.page-nav') as HTMLElement | null;
    const spacer = document.querySelector('.page-nav-spacer') as HTMLElement | null;
    const title = document.querySelector('.page-title') as HTMLElement | null;
    const scrollRoot = document.querySelector('.tv-content') as HTMLElement | null;

    if (!nav || !spacer || !title || !scrollRoot) return;

    function pin() {
      const rootRect = scrollRoot!.getBoundingClientRect();
      const navRect = nav!.getBoundingClientRect();
      spacer!.style.setProperty('--page-nav-height', navRect.height + 'px');
      nav!.style.setProperty('--page-nav-left', rootRect.left + 'px');
      nav!.style.setProperty('--page-nav-width', rootRect.width + 'px');
      nav!.style.top = rootRect.top + 'px';
      nav!.classList.add('is-pinned');
      spacer!.classList.add('is-visible');
    }

    function unpin() {
      nav!.classList.remove('is-pinned');
      nav!.style.top = '';
      spacer!.classList.remove('is-visible');
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          pin();
        } else {
          unpin();
        }
      },
      { root: scrollRoot, threshold: 0 }
    );

    observer.observe(title);

    // Update fixed position on resize (tv-content shifts)
    const resizeObserver = new ResizeObserver(() => {
      if (nav!.classList.contains('is-pinned')) pin();
    });
    resizeObserver.observe(scrollRoot);

    document.addEventListener('astro:before-swap', () => {
      observer.disconnect();
      resizeObserver.disconnect();
    }, { once: true });
  }

  // ─── Smooth scroll accounting for nav height ─────────────────────────────
  function initNavLinks() {
    const scrollRoot = document.querySelector('.tv-content') as HTMLElement | null;
    const navLinks = document.querySelectorAll('.page-nav__link');

    navLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        // Blur immediately so the rainbow focus style doesn't linger
        (link as HTMLElement).blur();

        const targetId = link.getAttribute('href');
        const targetElement = document.querySelector(targetId as string) as HTMLElement | null;
        if (!targetElement || !scrollRoot) return;

        // Calculate how far the target is from the current scroll position
        // inside the actual scroll container (.tv-content), not the window.
        const rootRect = scrollRoot.getBoundingClientRect();
        const targetRect = targetElement.getBoundingClientRect();
        // nav height offset so the target isn't hidden behind the pinned bar
        const nav = document.querySelector('.page-nav') as HTMLElement | null;
        const navOffset = (nav && nav.classList.contains('is-pinned')) ? nav.offsetHeight : 0;

        const targetScrollTop =
          scrollRoot.scrollTop + (targetRect.top - rootRect.top) - navOffset;

        scrollRoot.scrollTo({ top: targetScrollTop, behavior: 'smooth' });
      });
    });
  }

  // Initialize on page load
  initPageNav();
  initNavLinks();

  // Re-initialize after client-side navigation
  document.addEventListener('astro:after-swap', () => {
    initPageNav();
    initNavLinks();
  });

  // Rainbow cycling for whoami title
  // Use window-scoped state so any re-execution of this script (by Astro view
  // transitions) can always find and clear the previous interval.
  const titles = ['WHOAMI', 'moolut', 'Mevlüt Yıldırım'];

  function stopTitleCycling() {
    if (window.__whoamiTitleInterval != null) {
      clearInterval(window.__whoamiTitleInterval);
      window.__whoamiTitleInterval = null;
    }
  }

  function initTitleCycling() {
    stopTitleCycling();

    const titleElement = document.querySelector('.whoami-text');
    if (!titleElement) return;

    // Always start from the first title when (re-)initialising
    let titleIndex = 0;

    window.__whoamiTitleInterval = setInterval(() => {
      titleElement.classList.add('changing');

      setTimeout(() => {
        titleIndex = (titleIndex + 1) % titles.length;
        titleElement.textContent = titles[titleIndex];

        setTimeout(() => {
          titleElement.classList.remove('changing');
        }, 400);
      }, 200);
    }, 3000);
  }

  initTitleCycling();
  // Re-init after a client-side navigation brings this page into view,
  // and clean up before the page is swapped out so old intervals don't linger.
  document.addEventListener('astro:after-swap', initTitleCycling);
  document.addEventListener('astro:before-swap', stopTitleCycling);
</script>
