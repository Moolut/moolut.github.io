    techDetails: [
      'Frontend stack: Astro + Svelte + TypeScript + CSS.',
      'Component-first structure (cards, tabs, modal viewer, artifacts dock).',
      'UI states designed for both hover and keyboard focus navigation.',
    ],
    outputs: [
      'A production-ready portfolio with a distinctive theme and structured project presentation.',
    ],
    tools: ["Astro","Svelte","TypeScript","CSS (theme tokens)","GitHub Pages"],
    tags: ["Frontend","UI Systems","Retro CRT","Component Design","Portfolio"],
    artifacts: { github: 'https://github.com/Moolut/moolut.github.io', report: '', video: '', demo: 'https://moolut.github.io/' },
