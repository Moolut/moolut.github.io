---
import TVLayout from '../layouts/TVLayout.astro'

// ── Case file dataset (self-contained, no external import needed) ────────────
const CASE_FILES = [
  {
    fileId: 'UI',
    type: 'PROJECT',
    status: 'IN PROGRESS',
    group: 'SOFTWARE',
