]

// ── Derived constants ────────────────────────────────────────────────────────
const today   = new Date().toISOString().slice(0, 10)
const GROUPS   = ['ALL', 'SECURITY', 'EMBEDDED', 'SOFTWARE'] as const

type Group  = typeof GROUPS[number]
type Status = 'COMPLETE' | 'IN PROGRESS' | 'ARCHIVED'

const STATUS_META: Record<Status, { color: string }> = {
  'COMPLETE':    { color: '#4dff91' },
  'IN PROGRESS': { color: '#f0d030' },
  'ARCHIVED':    { color: '#ff5050' },
}

// ── Computed: attach displayId (text prefix + sequential number) ────────────
const CASES = CASE_FILES.map((f, i) => ({
  ...f,
  displayId: `${f.fileId}-${String(i + 1).padStart(3, '0')}`,
}))

function groupCount(g: Group) {
  return g === 'ALL'
    ? CASE_FILES.length
    : CASE_FILES.filter(f => f.group === g).length
}


---

<TVLayout title="projects">
  <article class="cf-page">

    {/* ── Serialise data for client JS (use a plain div — Astro strips script[type=*] from templates) ── */}
    <div id="cf-data" style="display:none" aria-hidden="true" set:text={JSON.stringify(CASES)}></div>

    {/* ── Page header ── */}
    <header class="cf-header">
      <div>
        <h1 class="cf-title">CASE FILES <span class="cf-title__slash">//</span> PROJECTS</h1>
        <p class="cf-subtitle">Documented work · structured findings · evidence on record.</p>
      </div>
      <div class="cf-hud">
        <span>FILES: <strong>{CASE_FILES.length}</strong></span>
        <span class="cf-hud__sep">|</span>
        <span>UPDATED: <strong>{today}</strong></span>
      </div>
    </header>

    {/* ── Folder-tab filter bar ── */}
    <nav class="cf-filter" aria-label="Filter by group">
      {GROUPS.map((g) => (
        <button
          class={`cf-filter__tab${g === 'ALL' ? ' cf-filter__tab--active' : ''}`}
          data-filter={g}
          aria-pressed={g === 'ALL' ? 'true' : 'false'}
        >
          {g}
          <span class="cf-filter__count">({groupCount(g)})</span>
        </button>
      ))}
    </nav>

    {/* ── Card grid ── */}
    <ul class="cf-grid" role="list" aria-label="Project case files">
      {CASES.map((f) => {
        const sm = STATUS_META[f.status as Status]

        return (
          <li
            class="cf-card"
            tabindex="0"
            data-group={f.group}
            data-slug={f.displayId}
          >
            {/* ① Folder tab */}
            <div class="cf-tab" aria-hidden="true">
              <span class="cf-tab__id">{f.displayId}</span>
              <span class="cf-tab__type">{f.type}</span>
            </div>

            {/* ② Paper-stack layers */}
            <div class="cf-layer cf-layer--1" aria-hidden="true"></div>
            <div class="cf-layer cf-layer--2" aria-hidden="true"></div>

            {/* ③ Card body */}
            <div class="cf-body">
              {/* Top bar */}
              <div class="cf-body__topbar" aria-hidden="true">
                <span class="cf-seq">{f.displayId.split('-')[1]}</span>
                <span
                  class="cf-stamp"
                  style={`color:${sm.color};border-color:${sm.color}`}
                  aria-label={`Status: ${f.status}`}
                >{f.status}</span>
              </div>

              {/* Title */}
              <h2 class="cf-title-card">{f.title}</h2>

              {/* Meta */}
              <p class="cf-meta">
                {f.context}<span class="cf-meta__sep" aria-hidden="true"> · </span>{f.year}
              </p>

              {/* PROBLEM + RESULT — 2-line clamp, expands on hover */}
              <dl class="cf-fields">
                <div class="cf-field">
                  <dt>PROBLEM</dt>
                  <dd title={f.problem}>{f.problem}</dd>
                </div>
                <div class="cf-field">
                  <dt>RESULT</dt>
                  <dd title={f.result}>{f.result}</dd>
                </div>
              </dl>

              {/* Tags */}
              <div class="cf-tags" role="list" aria-label="Tags">
                {f.tags.map((t: string) => (
                  <span class="cf-chip" role="listitem">{t}</span>
                ))}
                <span class="cf-chip cf-chip--more" aria-hidden="true"></span>
              </div>

              {/* CTA row — always visible */}
              <div class="cf-actions">
                <button
                  class="cf-btn cf-btn--primary"
                  data-read-case={f.displayId}
                  aria-label={`Open case file: ${f.title}`}
                >READ CASE →</button>
                {f.artifacts.github
                  ? <a class="cf-btn" href={f.artifacts.github} target="_blank" rel="noopener noreferrer">GITHUB</a>
                  : <span class="cf-btn cf-btn--locked" aria-disabled="true">GITHUB</span>
                }
                {f.artifacts.demo
                  ? <a class="cf-btn" href={f.artifacts.demo} target="_blank" rel="noopener noreferrer">DEMO</a>
                  : <span class="cf-btn cf-btn--locked" aria-disabled="true">DEMO</span>
                }
              </div>
            </div>
          </li>
        )
      })}
    </ul>

    {/* ── Inline placeholder when filter yields nothing ── */}
    <p class="cf-empty" hidden aria-live="polite">NO FILES MATCH THIS FILTER.</p>

  </article>

  {/* ── Modal overlay (one panel per case, all SSR'd) ── */}
  <div
    id="cf-modal"
    class="cfm-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby=""
    hidden
  >
    {/* Dim scrim */}
    <div class="cfm-scrim" aria-hidden="true"></div>

    {CASES.map((f) => {
      const sm = STATUS_META[f.status as Status]
      return (
        <div class="cfm-panel" data-modal-id={f.displayId} hidden>

          {/* Close */}
          <button class="cfm-close" aria-label="Close case file">✕</button>

          {/* Prev / Next */}
          <button class="cfm-nav cfm-nav--prev" aria-label="Previous case">◄</button>
          <button class="cfm-nav cfm-nav--next" aria-label="Next case">►</button>

          <div class="cfm-inner">

            {/* ── Left: dossier ── */}
            <div class="cfm-left">

              {/* Header tab-bar */}
              <div class="cfm-tabrow" aria-hidden="true">
                <div class="cfm-tab">
                  <span class="cfm-tab__id">{f.displayId}</span>
                  <span class="cfm-tab__type">{f.type}</span>
                </div>
                <span
                  class="cfm-stamp"
                  style={`color:${sm.color};border-color:${sm.color}`}
                  aria-label={`Status: ${f.status}`}
                >{f.status}</span>
              </div>

              {/* Scrollable body */}
              <div class="cfm-body">
                <h2 class="cfm-title" id={`cfm-title-${f.displayId}`}>{f.title}</h2>
                <p class="cfm-meta">
                  {f.context}<span aria-hidden="true"> · </span>{f.year}
                </p>

                {/* ── OVERVIEW ── */}
                <hr class="cfm-rule" aria-hidden="true" />
                <section class="cfm-section">
                  <h3 class="cfm-section__hd">OVERVIEW</h3>
                  <p class="cfm-prose">{f.overview}</p>
                </section>

                {/* ── WHAT I BUILT ── */}
                <hr class="cfm-rule" aria-hidden="true" />
                <section class="cfm-section">
                  <h3 class="cfm-section__hd">WHAT I BUILT</h3>
                  <ul class="cfm-list">
                    {(f.whatIBuilt as string[]).map((item) => (
                      <li class="cfm-list__item">{item}</li>
                    ))}
                  </ul>
                </section>

                {/* ── TECH DETAILS ── */}
                <hr class="cfm-rule" aria-hidden="true" />
                <section class="cfm-section">
                  <h3 class="cfm-section__hd">TECH DETAILS</h3>
                  <ul class="cfm-list cfm-list--tech">
                    {(f.techDetails as string[]).map((item) => (
                      <li class="cfm-list__item">{item}</li>
                    ))}
                  </ul>
                </section>

                {/* ── RESULTS ── */}
                <hr class="cfm-rule" aria-hidden="true" />
                <section class="cfm-section">
                  <h3 class="cfm-section__hd">RESULTS</h3>
                  <ul class="cfm-list cfm-list--result">
                    {(f.outputs as string[]).map((item) => (
                      <li class="cfm-list__item">{item}</li>
                    ))}
                  </ul>
                </section>

                {/* ── TOOLS / TAGS ── */}
                <hr class="cfm-rule" aria-hidden="true" />
                <div class="cfm-meta-grid">
                  <div class="cfm-row cfm-row--chips">
                    <span class="cfm-key">TOOLS</span>
                    <div class="cfm-chips">
                      {(f.tools as string[]).map((t) => <span class="cfm-chip">{t}</span>)}
                    </div>
                  </div>
                  <div class="cfm-row cfm-row--chips">
                    <span class="cfm-key">TAGS</span>
                    <div class="cfm-chips">
                      {(f.tags as string[]).map((t) => <span class="cfm-chip cfm-chip--tag">{t}</span>)}
                    </div>
                  </div>
                </div>

                {/* ── ARTIFACTS DOCK ── */}
                <hr class="cfm-rule" aria-hidden="true" />
                <section class="cfm-artifacts" aria-label="External artifacts">
                  <h3 class="cfm-artifacts__heading">ARTIFACTS DOCK</h3>
                  <div class="cfm-artifacts__links">
                    {(f.artifacts as any).github
                      ? <a class="cfm-art-btn" href={(f.artifacts as any).github} target="_blank" rel="noopener noreferrer">GITHUB ↗</a>
                      : <span class="cfm-art-btn cfm-art-btn--locked" aria-disabled="true">GITHUB · LOCKED</span>
                    }
                    {(f.artifacts as any).demo
                      ? <a class="cfm-art-btn" href={(f.artifacts as any).demo} target="_blank" rel="noopener noreferrer">DEMO ↗</a>
                      : <span class="cfm-art-btn cfm-art-btn--locked" aria-disabled="true">DEMO · LOCKED</span>
                    }
                    {(f.artifacts as any).report
                      ? <a class="cfm-art-btn" href={(f.artifacts as any).report} target="_blank" rel="noopener noreferrer">REPORT ↗</a>
                      : <span class="cfm-art-btn cfm-art-btn--locked" aria-disabled="true">REPORT · LOCKED</span>
                    }
                    {(f.artifacts as any).video
                      ? <a class="cfm-art-btn" href={(f.artifacts as any).video} target="_blank" rel="noopener noreferrer">VIDEO ↗</a>
                      : <span class="cfm-art-btn cfm-art-btn--locked" aria-disabled="true">VIDEO · LOCKED</span>
                    }
                  </div>
                </section>
              </div>
            </div>

            {/* ── Right: ghost panel ── */}
            <div class="cfm-ghost" aria-hidden="true">
              <div class="cfm-ghost__grid"></div>
              <div class="cfm-ghost__label">INTEL · {f.displayId}</div>
            </div>

          </div>
        </div>
      )
    })}
  </div>


{/* ══════════════════════════════════════════════════════════════════════
    Client-side logic: filter tabs + modal (open/close/nav/URL sync)
══════════════════════════════════════════════════════════════════════ */}
<script>
// ─── Data ───────────────────────────────────────────────────────────────────
const _dataEl = document.getElementById('cf-data')
const ALL_CASES: { fileId: string; displayId: string; group: string; [k: string]: unknown }[] =
  _dataEl ? JSON.parse(_dataEl.textContent || _dataEl.getAttribute('data-json') || '[]') : []

// ─── State ──────────────────────────────────────────────────────────────────
let activeGroup   = 'ALL'     // current folder-tab filter
let activeFileId  = ''        // currently open modal case id
let filteredIds:  string[] = [] // ordered file ids in current filter
let returnFocus:  HTMLElement | null = null // button that opened modal

const URL_PARAM = 'case'

// ─── Helpers ────────────────────────────────────────────────────────────────
function getModal()  { return document.getElementById('cf-modal') as HTMLElement }
function getPanel(id: string) {
  return getModal().querySelector<HTMLElement>(`[data-modal-id="${id}"]`)!
}
function allCards()  {
  return Array.from(document.querySelectorAll<HTMLElement>('.cf-card'))
}
function allPanels() {
  return Array.from(document.querySelectorAll<HTMLElement>('.cfm-panel'))
}

function getFocusable(root: HTMLElement): HTMLElement[] {
  return Array.from(
    root.querySelectorAll<HTMLElement>(
      'a[href],button:not([disabled]),input,textarea,[tabindex]:not([tabindex="-1"])'
    )
  ).filter(el => !el.hidden && !el.closest('[hidden]'))
}

// ─── Filter tab logic ────────────────────────────────────────────────────────
function applyFilter(group: string) {
  activeGroup = group

  // Update tab buttons
  document.querySelectorAll<HTMLElement>('.cf-filter__tab').forEach(btn => {
    const active = btn.dataset.filter === group
    btn.classList.toggle('cf-filter__tab--active', active)
    btn.setAttribute('aria-pressed', String(active))
  })

  // Show/hide cards
  let visible = 0
  allCards().forEach(card => {
    const match = group === 'ALL' || card.dataset.group === group
    card.hidden = !match
    if (match) visible++
  })

  // Empty state
  const empty = document.querySelector<HTMLElement>('.cf-empty')!
  empty.hidden = visible > 0

  // Rebuild filtered id list
  filteredIds = (group === 'ALL' ? ALL_CASES : ALL_CASES.filter(f => f.group === group))
    .map(f => f.displayId)
}

// ─── Modal open / close ──────────────────────────────────────────────────────
function openModal(fileId: string, trigger?: HTMLElement | null) {
  const modal = getModal()

  // Hide any open panel
  allPanels().forEach(p => p.setAttribute('hidden', ''))

  const panel = getPanel(fileId)
  if (!panel) return

  returnFocus  = trigger ?? null
  activeFileId = fileId

  panel.removeAttribute('hidden')
  modal.setAttribute('aria-labelledby', `cfm-title-${fileId}`)
  modal.removeAttribute('hidden')

  // Update prev/next button visibility
  syncNavButtons()

  document.body.style.overflow = 'hidden'
  document.addEventListener('keydown', onModalKeydown)

  requestAnimationFrame(() => {
    panel.querySelector<HTMLElement>('.cfm-close')?.focus()
  })
}

function closeModal(updateUrl = true) {
  const modal = getModal()
  allPanels().forEach(p => p.setAttribute('hidden', ''))
  modal.setAttribute('hidden', '')
  activeFileId = ''

  document.body.style.overflow = ''
  document.removeEventListener('keydown', onModalKeydown)

  returnFocus?.focus()
  returnFocus = null

  if (updateUrl) {
    const url = new URL(location.href)
    url.searchParams.delete(URL_PARAM)
    history.pushState({}, '', url)
  }
}

function syncNavButtons() {
  const panel = getPanel(activeFileId)
  if (!panel) return
  const idx  = filteredIds.indexOf(activeFileId)
  const prev = panel.querySelector<HTMLButtonElement>('.cfm-nav--prev')!
  const next = panel.querySelector<HTMLButtonElement>('.cfm-nav--next')!
  prev.disabled = idx <= 0
  next.disabled = idx >= filteredIds.length - 1
}

function navigateModal(dir: 1 | -1) {
  const idx  = filteredIds.indexOf(activeFileId)
  const next = filteredIds[idx + dir]
  if (!next) return
  allPanels().forEach(p => p.setAttribute('hidden', ''))
  activeFileId = next
  const nextPanel = getPanel(next)
  nextPanel.removeAttribute('hidden')
  getModal().setAttribute('aria-labelledby', `cfm-title-${next}`)
  syncNavButtons()
  nextPanel.querySelector<HTMLElement>('.cfm-close')?.focus()
  const url = new URL(location.href)
  url.searchParams.set(URL_PARAM, next)
  history.replaceState({ case: next }, '', url)
}

// ─── Focus trap + keyboard ────────────────────────────────────────────────────
function trapFocus(e: KeyboardEvent) {
  const modal  = getModal()
  if (modal.hidden) return
  const panel  = getPanel(activeFileId)
  if (!panel) return
  const items  = getFocusable(panel)
  if (!items.length) return
  if (e.key !== 'Tab') return
  const first = items[0]
  const last  = items[items.length - 1]
  if (e.shiftKey) {
    if (document.activeElement === first) { e.preventDefault(); last.focus() }
  } else {
    if (document.activeElement === last)  { e.preventDefault(); first.focus() }
  }
}

function onModalKeydown(e: KeyboardEvent) {
  if (e.key === 'Escape') { e.preventDefault(); closeModal() }
  else trapFocus(e)
}

// ─── URL sync ────────────────────────────────────────────────────────────────
function syncFromURL() {
  const slug = new URL(location.href).searchParams.get(URL_PARAM)
  if (slug) {
    // rebuild filteredIds with current group so nav works
    applyFilter(activeGroup)
    openModal(slug)
  } else if (!getModal().hidden) {
    closeModal(false)
  }
}

// ─── Init ────────────────────────────────────────────────────────────────────
function init() {
  // Initial filter
  applyFilter('ALL')

  // ── Filter tabs ──────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.cf-filter__tab').forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter!))
  })

  // ── READ CASE buttons ────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('[data-read-case]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id  = btn.dataset.readCase!
      const url = new URL(location.href)
      url.searchParams.set(URL_PARAM, id)
      history.pushState({ case: id }, '', url)
      openModal(id, btn)
    })
  })

  // ── Modal close buttons ──────────────────────────────────────────────────
  getModal().querySelectorAll<HTMLButtonElement>('.cfm-close').forEach(btn => {
    btn.addEventListener('click', () => closeModal())
  })

  // ── Modal scrim (click outside) ──────────────────────────────────────────
  getModal().querySelector('.cfm-scrim')!.addEventListener('click', () => closeModal())

  // ── Modal nav buttons ────────────────────────────────────────────────────
  getModal().querySelectorAll<HTMLButtonElement>('.cfm-nav').forEach(btn => {
    btn.addEventListener('click', () => {
      navigateModal(btn.classList.contains('cfm-nav--next') ? 1 : -1)
    })
  })

  // ── Card keyboard (Enter/Space opens modal) ──────────────────────────────
  document.querySelector('.cf-grid')!.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent
    if (ke.key !== 'Enter' && ke.key !== ' ') return
    if ((ke.target as Element).closest('a, button')) return
    const card = (ke.target as Element).closest<HTMLElement>('.cf-card')
    if (!card) return
    ke.preventDefault()
    card.querySelector<HTMLButtonElement>('[data-read-case]')?.click()
  })

  // ── Browser back/forward ─────────────────────────────────────────────────
  if (!(window as any).__cfPopstateBound) {
    ;(window as any).__cfPopstateBound = true
    window.addEventListener('popstate', () => syncFromURL())
  }

  // Auto-open if URL already has ?case=
  syncFromURL()
}

init()
document.addEventListener('astro:page-load', () => {
  ;(window as any).__cfPopstateBound = false
  init()
})

// ─── Tag overflow measurement ─────────────────────────────────────────────
function updateTagOverflow(container: HTMLElement) {
  const chips = Array.from(container.querySelectorAll<HTMLElement>('.cf-chip:not(.cf-chip--more)'))
  const more  = container.querySelector<HTMLElement>('.cf-chip--more')
  if (!chips.length || !more) return

  // Reset: show all chips, hide MORE
  chips.forEach(c => c.classList.remove('cf-chip--hide'))
  more.style.display = 'none'
  more.textContent    = ''

  const cRight = container.getBoundingClientRect().right

  // Find the first chip that clips past the container edge
  let cutoff = chips.length // assume all fit
  for (let i = 0; i < chips.length; i++) {
    if (chips[i].getBoundingClientRect().right > cRight + 1) {
      cutoff = i
      break
    }
  }
  if (cutoff === chips.length) return // everything fits, done

  // Iteratively hide chips from cutoff backwards until MORE itself fits.
  // We must hide the overflowing chips FIRST so that MORE lands in the
  // correct position before we measure it.
  for (let cut = cutoff; cut >= 0; cut--) {
    // Apply hide from cut onwards
    chips.forEach((c, i) => {
      if (i >= cut) c.classList.add('cf-chip--hide')
      else          c.classList.remove('cf-chip--hide')
    })
    more.style.display = 'inline-block'
    more.textContent   = `+${chips.length - cut} MORE`

    // If MORE fits now (or we've pulled all chips), we're done
    if (more.getBoundingClientRect().right <= cRight + 1 || cut === 0) break
  }
}

function updateAllTagOverflows() {
  document.querySelectorAll<HTMLElement>('.cf-tags').forEach(updateTagOverflow)
}

updateAllTagOverflows()
// Re-run after fonts load (web fonts change chip widths)
document.fonts.ready.then(updateAllTagOverflows)
window.addEventListener('resize', updateAllTagOverflows)
</script>

</TVLayout>

