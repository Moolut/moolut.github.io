---
import TVLayout from '../layouts/TVLayout.astro'
import { caseFiles } from '../modules/projects'
import type { CaseFile, CaseFileStatus } from '../modules/projects'

const today = new Date().toISOString().slice(0, 10)

const MAX_TAGS = 5

const STATUS_META: Record<CaseFileStatus, { color: string }> = {
  'COMPLETE':    { color: '#4dff91' },
  'IN PROGRESS': { color: '#f0d030' },
  'ARCHIVED':    { color: '#ff5050' },
}

function overflowCount(tags: string[]) {
  return tags.length > MAX_TAGS ? tags.length - MAX_TAGS : 0
}
---

<TVLayout title="projects">
  <article class="cf-page">

    <!-- ── Page header ── -->
    <header class="cf-header">
      <div>
        <h1 class="cf-title">CASE FILES <span class="cf-title__slash">//</span> PROJECTS</h1>
        <p class="cf-subtitle">Documented work · structured findings · evidence on record.</p>
      </div>
      <div class="cf-hud">
        <span>FILES: <strong>{caseFiles.length}</strong></span>
        <span class="cf-hud__sep">|</span>
        <span>UPDATED: <strong>{today}</strong></span>
      </div>
    </header>

    <!-- ── Card grid ── -->
    <ul class="cf-grid" role="list" aria-label="Project case files">
      {caseFiles.map((f: CaseFile, i: number) => {
        const sm      = STATUS_META[f.status]
        const visible = f.tags.slice(0, MAX_TAGS)
        const extra   = overflowCount(f.tags)
        const seq     = String(i + 1).padStart(2, '0')

        return (
          <li class="cf-card" tabindex="0" data-index={i}>

            {/* ① Folder tab */}
            <div class="cf-tab" aria-hidden="true">
              <span class="cf-tab__id">{f.fileId}</span>
              <span class="cf-tab__type">{f.type}</span>
            </div>

            {/* ② Paper-stack layers (decorative) */}
            <div class="cf-layer cf-layer--1" aria-hidden="true"></div>
            <div class="cf-layer cf-layer--2" aria-hidden="true"></div>

            {/* ③ Card body */}
            <div class="cf-body">

              {/* top bar: seq + status stamp */}
              <div class="cf-body__topbar" aria-hidden="true">
                <span class="cf-seq">{seq}</span>
                <span
                  class="cf-stamp"
                  style={`color:${sm.color};border-color:${sm.color}`}
                  aria-label={`Status: ${f.status}`}
                >{f.status}</span>
              </div>

              {/* title */}
              <h2 class="cf-title-card">{f.title}</h2>

              {/* context · year */}
              <p class="cf-meta">
                {f.context}<span class="cf-meta__sep" aria-hidden="true"> · </span>{f.year}
              </p>

              {/* PROBLEM / RESULT (collapsed); APPROACH lives in drawer) */}
              <dl class="cf-fields">
                <div class="cf-field">
                  <dt>PROBLEM</dt>
                  <dd title={f.problem}>{f.problem}</dd>
                </div>
                <div class="cf-field">
                  <dt>RESULT</dt>
                  <dd title={f.result}>{f.result}</dd>
                </div>
              </dl>

              {/* Tags */}
              <div class="cf-tags" role="list" aria-label="Tags">
                {visible.map((t: string) => (
                  <span class="cf-chip" role="listitem">{t}</span>
                ))}
                {extra > 0 && (
                  <span class="cf-chip cf-chip--more" role="listitem">+{extra}</span>
                )}
              </div>

              {/* Mobile accordion toggle (hidden on desktop pointer:fine) */}
              <button
                class="cf-dtoggle"
                aria-expanded="false"
                aria-controls={`cf-drawer-${i}`}
              >
                DETAILS <span class="cf-dtoggle__arrow" aria-hidden="true">▾</span>
              </button>

              {/* Hover/tap drawer — APPROACH + PIPELINE + TOOLS */}
              <div
                class="cf-drawer"
                id={`cf-drawer-${i}`}
                role="region"
                aria-label="Approach, pipeline and tools"
                hidden
              >
                <div class="cf-drawer__row">
                  <span class="cf-drawer__key">APPROACH</span>
                  <span class="cf-drawer__val">{f.approach}</span>
                </div>
                <div class="cf-drawer__row">
                  <span class="cf-drawer__key">PIPELINE</span>
                  <span class="cf-drawer__val">{f.pipeline}</span>
                </div>
                <div class="cf-drawer__row">
                  <span class="cf-drawer__key">TOOLS</span>
                  <span class="cf-drawer__val">{f.tools.join(' · ')}</span>
                </div>
              </div>

              {/* Action buttons */}
              <div class="cf-actions">
                <button class="cf-btn cf-btn--primary" data-read-case={f.slug}>READ CASE →</button>
                {f.links.github
                  ? <a class="cf-btn" href={f.links.github} target="_blank" rel="noopener noreferrer">GITHUB</a>
                  : <span class="cf-btn cf-btn--locked" aria-disabled="true">GITHUB</span>
                }
                {f.links.report
                  ? <a class="cf-btn" href={f.links.report} target="_blank" rel="noopener noreferrer">REPORT</a>
                  : <span class="cf-btn cf-btn--locked" aria-disabled="true">REPORT</span>
                }
                {f.links.video
                  ? <a class="cf-btn" href={f.links.video} target="_blank" rel="noopener noreferrer">VIDEO</a>
                  : <span class="cf-btn cf-btn--locked" aria-disabled="true">VIDEO</span>
                }
              </div>

            </div>
          </li>
        )
      })}
    </ul>

  </article>

  {/* ── Case file modal (pre-rendered panels, shown by JS) ── */}
  <div
    id="cf-modal"
    class="cfm-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby=""
    hidden
  >
    {/* Dim scrim (click to close) */}
    <div class="cfm-scrim" aria-hidden="true"></div>

    {/* One panel per case, JS shows the right one */}
    {caseFiles.map((f: CaseFile) => {
      const sm = STATUS_META[f.status]
      return (
        <div class="cfm-panel" data-modal-slug={f.slug} hidden>

          {/* Close button */}
          <button class="cfm-close" aria-label="Close case file">✕</button>

          <div class="cfm-inner">

            {/* ── Left: dossier content ── */}
            <div class="cfm-left">

              {/* Folder-tab header */}
              <div class="cfm-tabrow" aria-hidden="true">
                <div class="cfm-tab">
                  <span class="cfm-tab__id">{f.fileId}</span>
                  <span class="cfm-tab__type">{f.type}</span>
                </div>
                <span
                  class="cfm-stamp"
                  style={`color:${sm.color};border-color:${sm.color}`}
                  aria-label={`Status: ${f.status}`}
                >{f.status}</span>
              </div>

              {/* Scrollable body */}
              <div class="cfm-body">
                <h2 class="cfm-title" id={`cfm-title-${f.slug}`}>{f.title}</h2>

                <p class="cfm-meta">
                  {f.context}<span aria-hidden="true"> · </span>{f.year}
                </p>

                <hr class="cfm-rule" aria-hidden="true" />

                <dl class="cfm-fields">
                  <div class="cfm-field">
                    <dt>PROBLEM</dt>
                    <dd>{f.problem}</dd>
                  </div>
                  <div class="cfm-field">
                    <dt>APPROACH</dt>
                    <dd>{f.approach}</dd>
                  </div>
                  <div class="cfm-field">
                    <dt>RESULT</dt>
                    <dd>{f.result}</dd>
                  </div>
                </dl>

                <hr class="cfm-rule" aria-hidden="true" />

                <div class="cfm-row">
                  <span class="cfm-key">PIPELINE</span>
                  <span class="cfm-val">{f.pipeline}</span>
                </div>

                <div class="cfm-row cfm-row--chips">
                  <span class="cfm-key">TOOLS</span>
                  <div class="cfm-chips">
                    {f.tools.map((t: string) => <span class="cfm-chip">{t}</span>)}
                  </div>
                </div>

                <div class="cfm-row cfm-row--chips">
                  <span class="cfm-key">TAGS</span>
                  <div class="cfm-chips">
                    {f.tags.map((t: string) => <span class="cfm-chip cfm-chip--tag">{t}</span>)}
                  </div>
                </div>

                <hr class="cfm-rule" aria-hidden="true" />

                <section class="cfm-artifacts" aria-label="External artifacts">
                  <h3 class="cfm-artifacts__heading">ARTIFACTS DOCK</h3>
                  <div class="cfm-artifacts__links">
                    {f.links.github
                      ? <a class="cfm-art-btn" href={f.links.github} target="_blank" rel="noopener noreferrer">GITHUB ↗</a>
                      : <span class="cfm-art-btn cfm-art-btn--locked" aria-disabled="true">GITHUB</span>
                    }
                    {f.links.report
                      ? <a class="cfm-art-btn" href={f.links.report} target="_blank" rel="noopener noreferrer">REPORT ↗</a>
                      : <span class="cfm-art-btn cfm-art-btn--locked" aria-disabled="true">REPORT</span>
                    }
                    {f.links.video
                      ? <a class="cfm-art-btn" href={f.links.video} target="_blank" rel="noopener noreferrer">VIDEO ↗</a>
                      : <span class="cfm-art-btn cfm-art-btn--locked" aria-disabled="true">VIDEO</span>
                    }
                  </div>
                </section>
              </div>
            </div>

            {/* ── Right: ghost panel (decorative) ── */}
            <div class="cfm-ghost" aria-hidden="true">
              <div class="cfm-ghost__grid"></div>
              <div class="cfm-ghost__label">INTEL · {f.fileId}</div>
            </div>

          </div>
        </div>
      )
    })}
  </div>

</TVLayout>

{/* ── Scripts ── */}
<script>
// ────────────────────────────────────────────────
//  Drawer accordion (mobile)
// ────────────────────────────────────────────────
function initDrawers() {
  const grid = document.querySelector('.cf-grid')
  if (!grid) return

  grid.addEventListener('click', (e: Event) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('.cf-dtoggle')
    if (!btn) return
    const card   = btn.closest<HTMLElement>('.cf-card')!
    const drawer = card.querySelector<HTMLElement>('.cf-drawer')!
    const open   = btn.getAttribute('aria-expanded') === 'true'

    grid.querySelectorAll<HTMLElement>('.cf-card').forEach(c => {
      if (c === card) return
      c.querySelector<HTMLButtonElement>('.cf-dtoggle')?.setAttribute('aria-expanded', 'false')
      const d = c.querySelector<HTMLElement>('.cf-drawer')
      if (d) d.hidden = true
    })

    btn.setAttribute('aria-expanded', String(!open))
    drawer.hidden = open
  })

  grid.addEventListener('keydown', (e: Event) => {
    const ke = e as KeyboardEvent
    if (ke.key !== 'Enter' && ke.key !== ' ') return
    if ((ke.target as Element).closest('a, button')) return
    const card = (ke.target as Element).closest('.cf-card')
    if (!card) return
    ke.preventDefault()
    card.querySelector<HTMLButtonElement>('.cf-dtoggle')?.click()
  })
}

// ────────────────────────────────────────────────
//  Case file modal
// ────────────────────────────────────────────────
const PARAM = 'case'

let _modal:   HTMLElement | null = null
let _panel:   HTMLElement | null = null
let _trigger: HTMLElement | null = null

function getModal() {
  return _modal ?? (_modal = document.getElementById('cf-modal') as HTMLElement | null)
}

function getFocusable(root: HTMLElement): HTMLElement[] {
  return Array.from(
    root.querySelectorAll<HTMLElement>(
      'a[href],button:not([disabled]),input,textarea,select,[tabindex]:not([tabindex="-1"])'
    )
  ).filter(el => !el.closest('[hidden]'))
}

function trapFocus(e: KeyboardEvent) {
  const modal = getModal()
  if (!modal || e.key !== 'Tab') return
  const items = getFocusable(modal)
  if (!items.length) return
  const first = items[0]
  const last  = items[items.length - 1]
  if (e.shiftKey) {
    if (document.activeElement === first) { e.preventDefault(); last.focus() }
  } else {
    if (document.activeElement === last)  { e.preventDefault(); first.focus() }
  }
}

function onKeydown(e: KeyboardEvent) {
  if (e.key === 'Escape') closeModal()
  else trapFocus(e)
}

function openModal(slug: string, trigger?: HTMLElement | null) {
  const modal = getModal()
  if (!modal) return

  // hide any currently active panel
  _panel?.setAttribute('hidden', '')

  const panel = modal.querySelector<HTMLElement>(`[data-modal-slug="${slug}"]`)
  if (!panel) return

  _trigger = trigger ?? null
  _panel   = panel

  panel.removeAttribute('hidden')
  modal.setAttribute('aria-labelledby', `cfm-title-${slug}`)
  modal.removeAttribute('hidden')

  // lock body scroll
  document.body.style.overflow = 'hidden'

  // focus the close button
  requestAnimationFrame(() => {
    panel.querySelector<HTMLElement>('.cfm-close')?.focus()
  })

  document.addEventListener('keydown', onKeydown)
}

function closeModal(pushState = true) {
  const modal = getModal()
  if (!modal) return

  _panel?.setAttribute('hidden', '')
  _panel = null
  modal.setAttribute('hidden', '')

  document.body.style.overflow = ''
  document.removeEventListener('keydown', onKeydown)

  _trigger?.focus()
  _trigger = null

  if (pushState) {
    const url = new URL(location.href)
    url.searchParams.delete(PARAM)
    history.pushState({}, '', url)
  }
}

function syncFromURL() {
  const modal = getModal()
  if (!modal) return
  const slug = new URL(location.href).searchParams.get(PARAM)
  if (slug) {
    openModal(slug)
  } else if (!modal.hidden) {
    closeModal(false)
  }
}

function initModal() {
  const modal = getModal()
  if (!modal) return

  // Wire up all READ CASE buttons
  document.querySelectorAll<HTMLElement>('[data-read-case]').forEach(btn => {
    // prevent duplicate listeners on re-init
    if ((btn as any).__cfModalBound) return
    ;(btn as any).__cfModalBound = true

    btn.addEventListener('click', () => {
      const slug = (btn as HTMLButtonElement).dataset.readCase!
      const url  = new URL(location.href)
      url.searchParams.set(PARAM, slug)
      history.pushState({ case: slug }, '', url)
      openModal(slug, btn)
    })
  })

  // Scrim click → close
  const scrim = modal.querySelector('.cfm-scrim')
  if (scrim && !(scrim as any).__cfModalBound) {
    ;(scrim as any).__cfModalBound = true
    scrim.addEventListener('click', () => closeModal())
  }

  // All close buttons
  modal.querySelectorAll<HTMLElement>('.cfm-close').forEach(btn => {
    if ((btn as any).__cfModalBound) return
    ;(btn as any).__cfModalBound = true
    btn.addEventListener('click', () => closeModal())
  })

  // Back/forward browser nav
  if (!(window as any).__cfPopstateBound) {
    ;(window as any).__cfPopstateBound = true
    window.addEventListener('popstate', syncFromURL)
  }

  // Auto-open on page load if ?case=slug present
  syncFromURL()
}

initDrawers()
initModal()
document.addEventListener('astro:page-load', () => {
  // Reset bound flags so listeners are re-attached after navigation
  document.querySelectorAll('[data-read-case]').forEach(b => { delete (b as any).__cfModalBound })
  const m = document.getElementById('cf-modal')
  if (m) {
    delete (m.querySelector('.cfm-scrim') as any)?.__cfModalBound
    m.querySelectorAll('.cfm-close').forEach(b => { delete (b as any).__cfModalBound })
  }
  initDrawers()
  initModal()
})
</script>

<style>
  /* ════════════════════════════════════════════
     Design tokens (page-scoped)
  ════════════════════════════════════════════ */
  .cf-page {
    /* Teal/cyan = ONLY interactive accent */
    --cf-accent:   #00d4b8;
    --cf-accent-d: rgba(0, 212, 184, 0.10);
    --cf-accent-b: rgba(0, 212, 184, 0.25);

    /* Status colours — stamps only */
    --cf-ok:     #4dff91;   /* COMPLETE    */
    --cf-warn:   #f0d030;   /* IN PROGRESS */
    --cf-danger: #ff5050;   /* ARCHIVED    */

    /* Surfaces */
    --cf-panel: rgba(10, 16, 14, 0.97);
    --cf-text:  rgba(215, 232, 224, 0.92);
    --cf-muted: rgba(215, 232, 224, 0.45);
    --cf-bdr:   rgba(0, 212, 184, 0.14);

    font-family: var(--font-primary);
    color: var(--cf-text);
    max-width: 100%;
  }

  /* ════════════════════════════════════════════
     Page header
  ════════════════════════════════════════════ */
  .cf-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--cf-bdr);
  }

  .cf-title {
    font-size: clamp(18px, 2.8vw, 28px);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--cf-text);
    margin: 0 0 0.3rem;
  }

  .cf-title__slash {
    color: var(--cf-accent);
    opacity: 0.4;
  }

  .cf-subtitle {
    font-size: 0.58rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--cf-muted);
    margin: 0;
  }

  .cf-hud {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cf-accent);
    opacity: 0.5;
    white-space: nowrap;
  }

  .cf-hud__sep { opacity: 0.3; }

  /* ════════════════════════════════════════════
     Grid
  ════════════════════════════════════════════ */
  .cf-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    /* Extra row gap accommodates the stacked layers visually */
    gap: 3rem 2rem;
  }

  @media (min-width: 700px) {
    .cf-grid { grid-template-columns: 1fr 1fr; }
  }

  /* ════════════════════════════════════════════
     Card wrapper
  ════════════════════════════════════════════ */
  .cf-card {
    position: relative;
    display: flex;
    flex-direction: column;
    outline: none;
  }

  .cf-card:focus-visible {
    outline: 2px solid var(--cf-accent);
    outline-offset: 4px;
  }

  /* ── ① Folder tab ── */
  .cf-tab {
    position: relative;
    align-self: flex-start;       /* width = content, not full card */
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.26rem 1rem 0.28rem 0.65rem;
    background: rgba(0, 212, 184, 0.055);
    border: 1px solid var(--cf-bdr);
    border-bottom: none;
    z-index: 2;
    /* notched top-right corner like a real folder tab */
    clip-path: polygon(0 0, calc(100% - 9px) 0, 100% 9px, 100% 100%, 0 100%);
    transition: background 0.18s, border-color 0.18s;
  }

  /* Horizontal rule completing the folder top edge to the right of the tab */
  .cf-tab::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 100%;
    width: 100vw;
    height: 1px;
    background: var(--cf-bdr);
    pointer-events: none;
  }

  .cf-tab__id {
    font-size: 0.57rem;
    letter-spacing: 0.18em;
    color: var(--cf-accent);
    font-weight: bold;
  }

  .cf-tab__type {
    font-size: 0.41rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cf-accent);
    opacity: 0.4;
  }

  /* ── ② Paper-stack layers ── */
  .cf-layer {
    position: absolute;
    /* offset top by approx tab height so layers only sit behind the body */
    top: calc(1.6rem + 1px);
    bottom: 0;
    left: 0;
    right: 0;
    border: 1px solid var(--cf-bdr);
    background: rgba(0, 212, 184, 0.03);
    pointer-events: none;
    z-index: 0;
  }

  .cf-layer--1 { transform: translate(3px, 4px);  opacity: 0.6; }
  .cf-layer--2 { transform: translate(6px, 8px);  opacity: 0.3; }

  /* ── ③ Card body ── */
  .cf-body {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background: var(--cf-panel);
    border: 1px solid var(--cf-bdr);
    border-top: none;   /* tab's ::after line is the top border */
    padding: 1rem 1.1rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  /* Scanline wash */
  .cf-body::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 3px,
      rgba(0, 0, 0, 0.05) 3px,
      rgba(0, 0, 0, 0.05) 4px
    );
    pointer-events: none;
    z-index: 0;
  }

  .cf-body > * { position: relative; z-index: 1; }

  /* Card hover / focus-within */
  .cf-card:hover .cf-tab,
  .cf-card:focus-within .cf-tab {
    background: rgba(0, 212, 184, 0.10);
    border-color: var(--cf-accent-b);
  }

  .cf-card:hover .cf-tab::after,
  .cf-card:focus-within .cf-tab::after {
    background: var(--cf-accent-b);
  }

  .cf-card:hover .cf-body,
  .cf-card:focus-within .cf-body {
    border-color: var(--cf-accent-b);
    box-shadow:
      0 0 22px rgba(0, 212, 184, 0.07),
      inset 0 0 40px rgba(0, 212, 184, 0.025);
  }

  /* ── Top bar ── */
  .cf-body__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cf-seq {
    font-size: 0.4rem;
    letter-spacing: 0.2em;
    color: var(--cf-accent);
    opacity: 0.28;
  }

  /* ── Status stamp ── */
  .cf-stamp {
    display: inline-block;
    font-size: 0.44rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border: 1px dashed;
    padding: 0.14em 0.55em;
    transform: rotate(-2deg);
    filter: drop-shadow(0 0 3px currentColor);
    box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.4);
    opacity: 0.88;
  }

  /* ── Title ── */
  .cf-title-card {
    font-size: clamp(13px, 1.7vw, 16px);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--cf-text);
    line-height: 1.45;
    margin: 0;
    /* max 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Context · year ── */
  .cf-meta {
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cf-muted);
    margin: 0;
    line-height: 1.4;
  }

  .cf-meta__sep { opacity: 0.4; }

  /* ── PROBLEM / APPROACH / RESULT ── */
  .cf-fields {
    display: flex;
    flex-direction: column;
