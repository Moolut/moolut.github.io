<script>
  // Role cycling and timecode are handled in src/modules/navigation.js
  // (deselectScripts prevents this module from re-running during SPA navigations)

  // ── Live broadcast timecode for the About caption bar ──
  function pad(n) { return String(n).padStart(2, '0'); }

  function updateTimecode() {
    const el = document.getElementById('lt-timecode');
    if (!el) return;
    const n = new Date();
    el.textContent = `${pad(n.getHours())}:${pad(n.getMinutes())}:${pad(n.getSeconds())}`;
  }

  function initTimecode() {
    if (window.__timecodeInterval) clearInterval(window.__timecodeInterval);
    updateTimecode();
    window.__timecodeInterval = setInterval(updateTimecode, 1000);
  }

  initTimecode();
  document.addEventListener('astro:after-swap', initTimecode);
  document.addEventListener('astro:before-swap', () => {
    if (window.__timecodeInterval) clearInterval(window.__timecodeInterval);
  });

  // ── Caption bar: SUBTITLE toggle + MODE: DECODE ──────────────────────────
  // Logic lives in src/modules/navigation.js (initCaptionBar) so it runs
  // on startup regardless of entry page, bypassing deselectScripts().

  // Flip/wrap tooltip only when it would actually overflow the viewport
  function initTooltipFlip() {
    document.querySelectorAll('.highlight-link').forEach(el => {
      el.addEventListener('mouseenter', () => {
        // Reset classes first
        el.classList.remove('tooltip-flip', 'tooltip-wrap');

        // Temporarily make visible (hidden) to measure
        const pseudo = window.getComputedStyle(el, '::before');
        // Use a temporary element to measure tooltip width
        const measurer = document.createElement('span');
        measurer.style.cssText = `position:fixed;visibility:hidden;white-space:nowrap;font-size:16px;padding:0.5rem 1rem;pointer-events:none;z-index:-1`;
        measurer.textContent = el.dataset.info || '';
        document.body.appendChild(measurer);
        const tipW = measurer.offsetWidth;
        document.body.removeChild(measurer);

        const rect = el.getBoundingClientRect();
        const anchorX = rect.left + rect.width / 2;
        const tipLeft = anchorX - tipW / 2;
        const tipRight = anchorX + tipW / 2;
        const vw = window.innerWidth;

        if (tipRight > vw - 8) {
          // Would overflow right — flip to left-anchor
          el.classList.add('tooltip-flip');
          // Check if even flipped it overflows left
          const flippedLeft = rect.right - tipW;
          if (flippedLeft < 8) {
            el.classList.add('tooltip-wrap');
          }
        } else if (tipLeft < 8) {
          // Would overflow left — wrap in place
          el.classList.add('tooltip-wrap');
        }
      });
    });
  }

  initTooltipFlip();
  document.addEventListener('astro:after-swap', initTooltipFlip);
</script>
