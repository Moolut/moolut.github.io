---
import TVLayout from '../layouts/TVLayout.astro'
---

<TVLayout>
  <article class="welcome">
    <div class="hero-section">
      <div class="hero-name-row">
        <h1 class="big-text hero-title">
          <span class="name-hover" tabindex="0">Mevlüt Yıldırım</span>
        </h1>
        <div class="social-links">
          <a href="mailto:yldrmm.mevlut@gmail.com" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Email">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            <span>EMAIL</span>
          </a>
          <a href="https://linkedin.com/in/mevlut-yildirim" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span>LINKEDIN</span>
          </a>
          <a href="https://github.com/moolut" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.085 1.838 1.236 1.838 1.236 1.07 1.835 2.807 1.305 3.492.998.108-.776.42-1.305.763-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23A11.52 11.52 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.29-1.552 3.297-1.23 3.297-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.807 5.625-5.479 5.92.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.21.694.825.576C20.565 21.797 24 17.298 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GITHUB</span>
          </a>
          <a href="/resume" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Resume">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
            </svg>
            <span>RESUME</span>
          </a>
        </div>
      </div>
      <p class="hero-tagline">
        <span class="role-text">Cybersecurity Engineer </span>
        <span class="static-text">based in <span class="munich-hover">Munich</span></span>
      </p>
    </div>

    <div class="lower-third">
      <div class="lower-third-panel">
        <div class="lower-third-body">
          <div class="lower-third-caption-bar">
            <div class="caption-left">
              <span class="caption-tag">// ABOUT</span>
              <span class="caption-meta" id="lt-caption-meta">CAPTION: ABOUT</span>
              <button class="caption-decode-btn" id="lt-decode-btn" title="Decode text animation">MODE: DECODE</button>
            </div>
            <div class="caption-right">
              <span class="caption-timecode" id="lt-timecode">00:00</span>
              <span class="caption-subtitle-flag" id="lt-subtitle-toggle" data-mode="ON" role="button" tabindex="0" title="Shift+click for hidden mode">SUBTITLE: ON &#9654;</span>
            </div>
          </div>
          <div class="lower-third-content">
            <!-- SUBTITLE modes -->
            <!-- SUBTITLE: ON — full paragraphs -->
            <div class="subtitle-mode subtitle-mode-on">
              <p class="intro-text">
                Some people collect tools — I collect
                <strong class="highlight-link" data-info="The habit of poking at &quot;normal&quot; behavior until the edge cases start talking.">questions</strong>.
                What happens if this input is just slightly off? If a system trusts the wrong detail, just once?
                If a harmless
                <strong class="highlight-link" data-info="The &quot;it&apos;ll be fine&quot; parts of a design that quietly become vulnerabilities.">assumption</strong>
                turns into an
                <strong class="highlight-link" data-info="Small, boring steps that chain into something serious.">attack path</strong>?
                That curiosity is what pulled me into <strong class="highlight">cybersecurity</strong> and what keeps me here.
              </p>
              <p class="intro-text">
                I&apos;m an <strong class="highlight">ethical hacker</strong> who enjoys living in the
                <strong class="highlight-link" data-info="The space between &quot;passes tests&quot; and &quot;survives an adversary.&quot;">gap</strong>
                between &ldquo;it works&rdquo; and &ldquo;it&apos;s secure.&rdquo; I enjoy both breaking things
                ethically through <strong class="highlight">offensive testing</strong> and thinking like an analyst on the
                <strong class="highlight">defensive side</strong>, connecting signals into a clear incident story.
                Whether it&apos;s an enterprise environment, a web app, or a
                connected device, I like mapping how
                trust is built, where it silently expands, and where it can be bent.
              </p>
              <p class="intro-text">
                I keep things practical: explore, test, document, improve. I&apos;m most at home when
                <strong class="highlight">security becomes concrete</strong>, when the uncomfortable details are
                turned into <strong class="highlight">clear evidence</strong>, and systems leave
                the page a little harder to break.
              </p>
            </div>

            <!-- SUBTITLE: CC1 — line-based format -->
            <div class="subtitle-mode subtitle-mode-cc1" hidden>
              <div class="cc-lines">
                <span class="cc-line">Questions are how I got into cybersecurity.</span>
                <span class="cc-line">Ethical hacker. Offensive + defensive thinking.</span>
                <span class="cc-line">I track where trust silently expands, then bends.</span>
                <span class="cc-line">Explore. Test. Document. Improve.</span>
                <span class="cc-line">Make security concrete. Leave systems harder to break.</span>
              </div>
            </div>

            <!-- SUBTITLE: CC2 — data-card format -->
            <div class="subtitle-mode subtitle-mode-cc2" hidden>
              <div class="cc-info-block">
                <div class="cc-row"><span class="cc-key">ROLE:</span><span class="cc-val">Ethical Hacker / Security Researcher</span></div>
                <div class="cc-row"><span class="cc-key">FOCUS:</span><span class="cc-val">Offensive Testing + Defensive Analysis</span></div>
                <div class="cc-row"><span class="cc-key">SCOPE:</span><span class="cc-val">Web / Enterprise / Connected Systems</span></div>
                <div class="cc-row"><span class="cc-key">METHOD:</span><span class="cc-val">Explore &rarr; Test &rarr; Document &rarr; Improve</span></div>
                <div class="cc-row"><span class="cc-key">STATUS:</span><span class="cc-val">Still looking for the flag</span></div>
              </div>
            </div>

            <!-- SUBTITLE: EGG — easter egg -->
            <div class="subtitle-mode subtitle-mode-egg" hidden>
              <div class="cc-egg">
                <p class="cc-egg-line"><span class="cc-egg-prompt">root@visitor:~#</span> whoami</p>
                <p class="cc-egg-line cc-egg-out">curious_human</p>
                <p class="cc-egg-line"><span class="cc-egg-prompt">root@visitor:~#</span> cat /flag.txt</p>
                <p class="cc-egg-line cc-egg-out">FLAG&#123;y0u_cl1ck3d_4_t1m3s_gg&#125;</p>
                <p class="cc-egg-line"><span class="cc-egg-prompt">root@visitor:~#</span> cat /etc/motd</p>
                <p class="cc-egg-line cc-egg-out">No zero-days here. Probably.</p>
                <p class="cc-egg-line cc-egg-out">Nice persistence though. &mdash; m00lut<span class="cc-cursor">_</span></p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="lower-third-tracking"></div>
    </div>

    <section class="what-drives-me">
      <h2 class="section-title">What Drives Me</h2>
      <div class="drives-grid">

        <div class="drive-card card-crt-glass">
          <div class="card-header-strip">SYS://PROBE &nbsp;▌</div>
          <div class="card-channel"><span>CH-01</span></div>
          <h3 class="drive-title">
            <span class="card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="1" y="1" width="10" height="10" stroke="currentColor" stroke-width="1.5"/>
                <line x1="10" y1="11" x2="17" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="square"/>
              </svg>
            </span>
            Curiosity with purpose
          </h3>
          <p class="drive-description">
            I thrive on turning questions into structured testing. I like pressure-checking assumptions,
            uncovering what&apos;s hidden, and making systems
            <strong class="highlight-link" data-info="When real behavior is proven, not assumed.">honest</strong>
            through ethical hacking, not guesswork. That
            <strong class="highlight-link" data-info="Curiosity aimed at a clear security outcome, not random exploration.">purpose</strong>
            is what keeps the work from becoming noise.
          </p>
          <div class="card-footer">
            <span class="card-status">MODE: ACTIVE</span>
            <div class="card-confidence"><div class="confidence-fill" style="width:82%"></div></div>
          </div>

        </div>

        <div class="drive-card card-vhs-label">
          <div class="card-header-strip">SYS://LEARN &nbsp;▌</div>
          <div class="card-channel"><span>CH-02</span></div>
          <h3 class="drive-title">
            <span class="card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 15V4C9 4 6 2.5 2 4V15C6 13.5 9 15 9 15Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M9 15V4C9 4 12 2.5 16 4V15C12 13.5 9 15 9 15Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            </span>
            Learning that compounds
          </h3>
          <p class="drive-description">
            I treat learning as a discipline: labs, deep dives, and hands-on experiments. I stay
            close to modern threats like AI-enabled attacks, prompt manipulation, and cyber-physical
            security, building mental models that
            <strong class="highlight-link" data-info="Knowledge that applies across different environments.">transfer</strong>
            and skills that
            <strong class="highlight-link" data-info="Skills that stack over time and accelerate future learning.">compound</strong>.
          </p>
          <div class="card-footer">
            <span class="card-status">INDEX: GROWING</span>
            <div class="card-confidence"><div class="confidence-fill" style="width:91%"></div></div>
          </div>

        </div>

        <div class="drive-card card-terminal">
          <div class="card-header-strip">SYS://IMPACT &nbsp;▌</div>
          <div class="card-channel"><span>CH-03</span></div>
          <h3 class="drive-title">
            <span class="card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="9" cy="9" r="7.5" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="9" cy="9" r="4" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="9" cy="9" r="1.5" fill="currentColor"/>
              </svg>
            </span>
            Impact through evidence
          </h3>
          <p class="drive-description">
            I&apos;m driven by outcomes that reduce real risk. I focus on reproducible findings, clear
            reasoning, and practical
            <strong class="highlight-link" data-info="Changes that remove the cause, not the symptom.">remediation</strong>
            so results don&apos;t just get noticed — backed by solid
            <strong class="highlight-link" data-info="Results that show what breaks, why it breaks, and how to fix it.">evidence</strong>,
            they get fixed.
          </p>
          <div class="card-footer">
            <span class="card-status">OUTPUT: VERIFIED</span>
            <div class="card-confidence"><div class="confidence-fill" style="width:76%"></div></div>
          </div>

        </div>

        <div class="drive-card card-warning-tape">
          <div class="card-header-strip">SYS://BUILD &nbsp;▌</div>
          <div class="card-channel"><span>CH-04</span></div>
          <h3 class="drive-title">
            <span class="card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polyline points="11,1 4,10 9,10 7,17 14,8 9,8 11,1" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            </span>
            Innovation that makes others faster
          </h3>
          <p class="drive-description">
            I enjoy building tools and methodologies that reduce guesswork and increase precision.
            The goal is
            <strong class="highlight-link" data-info="A method others can run and trust, not a one-off win.">repeatable</strong>
            security work that helps teams move
            <strong class="highlight-link" data-info="Less time lost to uncertainty, more time spent on what matters.">faster</strong>
            without losing depth.
          </p>
          <div class="card-footer">
            <span class="card-status">PIPELINE: OPEN</span>
            <div class="card-confidence"><div class="confidence-fill" style="width:88%"></div></div>
          </div>

        </div>

      </div>
    </section>


    <div class="call-to-action-section">
      <p class="call-to-action">
        <a href="/whoami/">Learn more about me</a> or check out my
        <a href="/projects/">projects</a> and
        <a href="/certifications/">achievements</a>.
      </p>
    </div>
  </article>
</TVLayout>

<style>
  /* Remove glitchy text effect from body content */
  .welcome,
  .welcome * {
    text-shadow: none !important;
  }

  .welcome {
    max-width: 100%;
  }

  /* Hero Section */
  .hero-section {
    margin-bottom: 1.75rem;
  }

  /* Name on the left, social links pinned to the right, baseline-aligned */
  .hero-name-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .hero-title {
    margin: 0;
    text-transform: uppercase;
    flex-shrink: 1;
    min-width: 0;
    line-height: 1;
  }

  .hero-tagline {
    font-size: clamp(20px, 2.6vw, 28px);
    line-height: 1.4;
    margin: 0.4rem 0 0 0;
    min-height: 1.5em;
  }

  .static-text {
    margin-left: 0.5ch;
  }

  /* ── Social links: horizontal row aligned to the right of the name ── */
  .social-links {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.5em 1.1em;
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: var(--text-secondary);
    text-decoration: none;
    text-transform: uppercase;
    font-size: clamp(11px, 1.2vw, 14px);
    white-space: nowrap;
    letter-spacing: 0.12em;
    position: relative;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.05);
    background-image: none !important;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .social-link svg {
    position: relative;
    z-index: 1;
    width: 1.1em;
    height: 1.1em;
    flex-shrink: 0;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .social-link span {
    position: relative;
    z-index: 1;
  }

  /* CRT scan sweep */
  .social-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.07) 50%,
      transparent 100%
    );
    transform: translateX(-100%);
    pointer-events: none;
    z-index: 0;
  }

  .social-link:hover::before {
    animation: scanH 0.4s ease forwards;
  }

  @keyframes scanH {
    to { transform: translateX(100%); }
  }

  .social-link:hover {
    border-color: #fff;
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    box-shadow:
      2px 0 0 0 var(--glitchy-blue),
      -2px 0 0 0 var(--glitchy-red),
      0 0 12px rgba(255, 255, 255, 0.12);
  }

  .social-link:hover svg {
    opacity: 1;
  }

  /* Role text with rainbow-static effect */
  .role-text {
    display: inline-block;
    position: relative;
    color: var(--text-secondary);
    font-weight: 600;
    background-position: center center;
    background-size: 90% 0;
    background-repeat: no-repeat;
    transition: background-size 0.4s cubic-bezier(0.29, 0.8, 0.21, 0.63);
  }

  html:not(.webp) .role-text {
    background-image: url(/assets/images/rainbow-static.gif);
  }

  html.webp .role-text {
    background-image: url(/assets/images/rainbow-static.webp);
  }

  .role-text.changing {
    background-size: 100% 100%;
  }

  /* Name hover effect to show profile photo */
  .name-hover {
    position: relative;
    color: var(--text-secondary);
  }

  .name-hover::after {
    content: '';
    display: block;
    position: absolute;
    z-index: 100;
    top: calc(100% + 1em);
    left: 1rem;
    width: 14rem;
    padding-bottom: 14rem;
    visibility: hidden;
    background-size: cover;
    background-position: center;
    border: 2px solid var(--text-secondary);
  }

  .name-hover:hover::after,
  .name-hover:focus::after {
    background-image: url(/assets/images/profile.png);
    transition: visibility 0s 0.2s;
    visibility: visible;
  }

  /* Munich hover effect to show munich.png */
  .munich-hover {
    position: relative;
    color: var(--text-secondary);
    cursor: default;
  }

  .munich-hover::after {
    content: '';
    display: block;
    position: absolute;
    z-index: 100;
    bottom: calc(100% + 0.75em);
    left: 50%;
    transform: translateX(-50%);
    width: 14rem;
    padding-bottom: 14rem;
    visibility: hidden;
    background-size: cover;
    background-position: center;
    border: 2px solid var(--text-secondary);
  }

  .munich-hover:hover::after {
    background-image: url(/assets/images/munich.png);
    transition: visibility 0s 0.2s;
    visibility: visible;
    filter: contrast(1.1) saturate(1.05);
  }

  /* ── Lower-Third "Broadcast" About Panel ── */
  .lower-third {
    margin-top: 1.25rem;
    margin-bottom: 2rem;
    position: relative;
  }

  .lower-third-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  /* ── Caption bar — top strip inside the panel ── */
  .lower-third-caption-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    position: relative;
    z-index: 2;
  }

  .caption-left {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .caption-tag {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .caption-meta {
    color: rgba(255, 255, 255, 0.5);
  }

  .caption-right {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .caption-timecode {
    color: rgba(255, 255, 255, 0.65);
    font-variant-numeric: tabular-nums;
  }

  .caption-subtitle-flag {
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 2px 8px;
    line-height: 1.5;
    cursor: var(--cursor-pointer);
    user-select: none;
    transition: color 0.15s, border-color 0.15s, background 0.15s, transform 0.08s, box-shadow 0.15s;
  }

  .caption-subtitle-flag:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.6);
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.2);
  }

  .caption-subtitle-flag:active {
    transform: translateY(1px);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: none;
  }

  .caption-subtitle-flag[data-mode="OFF"] {
    color: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .caption-subtitle-flag[data-mode="CC1"] {
    color: #7dd8ff;
    border-color: #7dd8ff;
    background: rgba(125, 216, 255, 0.12);
  }

  .caption-subtitle-flag[data-mode="CC2"] {
    color: #ff8080;
    border-color: #ff8080;
    background: rgba(255, 128, 128, 0.12);
  }

  .caption-subtitle-flag[data-mode="EGG"] {
    color: #ffe066;
    border-color: #ffe066;
    background: rgba(255, 224, 102, 0.1);
    animation: eggGlow 1.4s ease-in-out infinite;
  }

  @keyframes eggGlow {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* Decode button in caption bar */
  .caption-decode-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 2px 8px;
    cursor: var(--cursor-pointer);
    line-height: 1.5;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

