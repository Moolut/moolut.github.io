    color: rgba(255, 255, 255, 0.65);
    text-transform: uppercase;
  }

  /* ── Mobile ── */
  @media (max-width: 580px) {
    .hud-strip {
      font-size: 0.55rem;
    }

    .hero-card__left {
      padding-right: 0;
    }

    .hero-card__corner {
      position: static;
      flex-direction: row-reverse;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.75rem;
    }
