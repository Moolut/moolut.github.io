---
import TVLayout from '../layouts/TVLayout.astro'
import achievementsData from '../data/achievements.json'
import global from '../data/global.json'

// ── Types ────────────────────────────────────────────────────────────────────
interface CertItem {
  tag: string; title: string; issuer: string; year: string
  url: string; urlLabel: string
  chips: string[]; chipsMore: string[]
}
interface CtfItem {
  year: string; place: string; name: string; org: string; keywords: string[]
}
interface HtbItem {
  name: string; status: string; fill: number; pct: string
  pipeline: string; practiced: string; output: string
}
interface Channel {
  id: string; sys: string; type: string
  hudLabel: string; statusLine: string
  title?: string; intro?: string; htbStatus?: string
  items: (CertItem | CtfItem | HtbItem)[]
}

const channels = achievementsData.channels as Channel[]

const today = global.lastUpdated
---

<TVLayout title="achievements">
  <article class="achievements">
    <h1 class="page-title">ACHIEVEMENTS & HONORS</h1>

    <!-- ── HUD STRIP (generated from channel list) ── -->
    <div class="hud-strip" aria-label="Achievement summary">
      <div class="hud-nav">
        {channels.map((ch, i) => (
          <>
            {i > 0 && <span class="hud-sep">|</span>}
            <button class="hud-link" data-target={`#${ch.id}`}>
              {ch.hudLabel}: <strong>{ch.items.length}</strong>
            </button>
          </>
        ))}
      </div>
      <span class="hud-updated">UPDATED: <strong>{today}</strong></span>
    </div>

    <!-- ── CHANNELS (rendered dynamically by type) ── -->
    {channels.map((ch) => (
      <section class="block" id={ch.id}>
        <div class="block-header">
          <span class="block-sys">{ch.sys}</span>
          <span class="block-ch">{ch.id.toUpperCase()}</span>
        </div>

        {/* ── type: certifications ── */}
        {ch.type === 'certifications' && (
          <>
            {(ch.items as CertItem[]).map((cert) => (
              <div class="hero-card">
                <div class="hero-card__corner">
                  <a class="btn-retro" href={cert.url} target="_blank" rel="noopener">
                    {cert.urlLabel}
                  </a>
                </div>
                <div class="hero-card__left">
                  <span class="hero-card__tag">[{cert.tag}]</span>
                  <h2 class="hero-card__title">{cert.title}</h2>
                  <p class="hero-card__meta">
                    <span class="hero-card__issuer">{cert.issuer}</span>
                    <span class="hero-card__sep">·</span>
                    <span class="hero-card__year">{cert.year}</span>
                  </p>
                  <div class="hero-card__chips">
                    <div class="chip-row">
                      {cert.chips.slice(0, 4).map((c) => <span class="chip">{c}</span>)}
                    </div>
                    {(cert.chips.length > 4 || cert.chipsMore.length > 0) && (
                      <div class="chip-row">
                        {cert.chips.slice(4).map((c) => <span class="chip">{c}</span>)}
                        {cert.chipsMore.length > 0 && (
                          <span class="chip-more" tabindex="0">
                            +{cert.chipsMore.length} more
                            <span class="chip-more__popover">
                              {cert.chipsMore.map((c) => <span>{c}</span>)}
                            </span>
                          </span>
                        )}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </>
        )}

        {/* ── type: ctf ── */}
        {ch.type === 'ctf' && (
          <>
            <h2 class="block-title">{ch.title}</h2>
            <p class="block-intro">{ch.intro}</p>
            <ol class="timeline">
              {(ch.items as CtfItem[]).map((e) => (
                <li class="timeline-item">
                  <div class="timeline-body">
                    <p class="timeline-main">
                      <span class="timeline-place">{e.place}</span>
                      <span class="timeline-name">{e.name}</span>
                    </p>
                    <p class="timeline-desc">{e.org}</p>
                    <div class="timeline-keywords">
                      {e.keywords.map((k) => <span class="chip">{k}</span>)}
                    </div>
                  </div>
                  <span class="timeline-year">{e.year}</span>
                </li>
              ))}
            </ol>
          </>
        )}

        {/* ── type: htb ── */}
        {ch.type === 'htb' && (
          <>
            <div class="htb-header">
              <h2 class="block-title">{ch.title}</h2>
              {ch.htbStatus && (
                <span class="htb-status">STATUS: <strong>{ch.htbStatus}</strong></span>
              )}
            </div>
            <p class="path-hint">// HOVER PATH FOR DETAILS</p>
            <ul class="path-list">
              {(ch.items as HtbItem[]).map((p) => (
                <li class="path-row">
                  <div class="path-default">
                    <span class="path-arrow" aria-hidden="true">
                      <span class="path-arrow__off">▸</span>
                      <span class="path-arrow__on">▶</span>
                    </span>
                    <span class="path-name">{p.name}</span>
                    <span class={`path-status ${p.status === 'COMPLETE' ? '--complete' : '--progress'}`}>
                      {p.status}{p.pct ? ` ${p.pct}` : ''}
                    </span>
                    <div class="path-bar-track" style={`--fill: ${p.fill}%`}>
                      <div class="path-bar-fill"></div>
                    </div>
                  </div>
                  <div class="path-panel">
                    <div class="path-panel__line">
                      <span class="pp-key">PIPELINE</span>
                      <span class="pp-val">{p.pipeline}</span>
                    </div>
                    <div class="path-panel__line">
                      <span class="pp-key">PRACTICED</span>
                      <span class="pp-val">{p.practiced}</span>
                    </div>
                    <div class="path-panel__line">
                      <span class="pp-key">OUTPUT</span>
                      <span class="pp-val">{p.output}</span>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </>
        )}

        <div class="block-status">{ch.statusLine}</div>
      </section>
    ))}
  </article>
</TVLayout>

<style>
  /* ── Base ── */
  .achievements {
    max-width: 100%;
  }

  .page-title {
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    color: #fff;
    font-size: clamp(28px, 4vw, 48px);
  }

  /* ── HUD Strip ── */
  .hud-strip {
    display: flex;
    align-items: center;
    position: relative;
    font-family: var(--font-primary);
    font-size: clamp(0.6rem, 1.1vw, 0.72rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffcc00;
    background: rgba(255, 204, 0, 0.06);
    border: 1px solid rgba(255, 204, 0, 0.2);
    padding: 0.45em 0.9em;
    margin-bottom: 3rem;
  }

  .hud-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem 0.9rem;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .hud-sep {
    opacity: 0.3;
  }

  .hud-link {
    /* button reset */
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    /* styles */
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dashed;
    text-decoration-color: rgba(255, 204, 0, 0.3);
    text-underline-offset: 3px;
    cursor: var(--cursor-pointer);
    transition: opacity 0.15s, text-decoration-color 0.15s, text-shadow 0.15s;
    opacity: 0.85;
    background-image: none !important;
    background-size: 0 0 !important;

    &:hover {
      opacity: 1;
      text-decoration-style: solid;
      text-decoration-color: rgba(255, 204, 0, 0.9);
      text-shadow: 0 0 10px rgba(255, 204, 0, 0.55);
      background-image: none !important;
    }
  }

  .hud-updated {
    margin-left: auto;
    text-align: right;
    opacity: 0.3;
    font-size: 0.55rem;
    letter-spacing: 0.07em;
  }

  /* Offset scroll targets so they aren't hidden behind the sticky HUD strip */
  /* Matches any section id starting with "ch-" so new channels work automatically */
  [id^="ch-"] {
    scroll-margin-top: 48px;
  }

  /* ── Shared Block ── */
  .block {
    padding-bottom: 2rem;
    margin-bottom: 2rem;

    &:last-of-type {
      margin-bottom: 0;
    }
  }

  .block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-primary);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .block-sys {
    font-size: 0.6rem;
    font-weight: bold;
    letter-spacing: 0.15em;
    color: #ffcc00;
    opacity: 0.7;
    border: 1px solid rgba(255, 204, 0, 0.28);
    padding: 0.2em 0.6em;

    &::before { content: '[ '; }
    &::after  { content: ' ]'; }
  }

  .block-ch {
    font-size: 0.52rem;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.28);
  }

  .block-title {
    font-size: clamp(18px, 2.2vw, 26px);
    font-weight: bold;
    text-transform: uppercase;
    margin: 0 0 1rem;
    color: #fff;
  }

  .block-intro {
    font-size: clamp(15px, 1.7vw, 19px);
    opacity: 1;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .block-status {
    font-family: var(--font-primary);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 204, 0, 0.55);
    opacity: 1;
    margin-top: 1.5rem;
  }

  /* ── Hero Card ── */
  .hero-card {
    position: relative;
    border: 1px solid rgba(255, 204, 0, 0.25);
    background: rgba(255, 204, 0, 0.03);
    padding: 1.1rem 1.2rem;
    transition:
      border-color 0.25s,
      box-shadow 0.25s,
      background 0.25s;

    &:hover {
      border-color: rgba(255, 204, 0, 0.55);
      background: rgba(255, 204, 0, 0.06);
      box-shadow:
        0 0 20px rgba(255, 204, 0, 0.1),
        inset 0 0 30px rgba(255, 204, 0, 0.03);
    }
  }

  .hero-card__corner {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  .hero-card__left {
    flex: 1;
    min-width: 0;
    padding-right: 8rem;
  }

  .hero-card__right {
    display: none;
  }

  .hero-card__top {
    display: block;
  }

  .hero-card__footer {
    display: none;
  }

  .hero-card__tag {
    font-family: var(--font-primary);
    font-size: 0.7rem;
    color: #ffcc00;
    letter-spacing: 0.12em;
    display: block;
    margin-bottom: 0.3rem;
  }

  .hero-card__title {
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: bold;
    text-transform: uppercase;
    margin: 0 0 0.35rem;
    color: #fff;
  }

  .hero-card__meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: clamp(14px, 1.5vw, 16px);
    opacity: 0.75;
    margin: 0 0 0.7rem;
  }

  .hero-card__sep {
    opacity: 0.4;
  }

  .hero-card__chips {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
    align-items: center;
  }

  .chip {
    font-family: var(--font-primary);
    font-size: 0.55rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.15em 0.5em;
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.6);
  }

  .chip-more {
    position: relative;
    font-family: var(--font-primary);
    font-size: 0.55rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.15em 0.5em;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.35);
    cursor: default;
    user-select: none;
    transition: color 0.15s, border-color 0.15s;

    &:hover,
    &:focus {
      color: rgba(255, 204, 0, 0.8);
      border-color: rgba(255, 204, 0, 0.35);
    }

    &:hover .chip-more__popover,
    &:focus .chip-more__popover,
    &:focus-within .chip-more__popover {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }

  .chip-more__popover {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: #0e0e0e;
    border: 1px solid rgba(255, 204, 0, 0.25);
    padding: 0.4em 0.6em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
    transition: opacity 0.15s, transform 0.15s;
    z-index: 20;

    & span {
      font-family: var(--font-primary);
      font-size: 0.55rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.7);
    }
  }

  .btn-retro {
    display: inline-block;
    font-family: var(--font-primary);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.45em 1em;
    border: 1px solid rgba(255, 204, 0, 0.6);
    color: #ffcc00;
    background: rgba(255, 204, 0, 0.07);
    background-image: none !important;
    box-shadow:
      0 0 6px rgba(255, 204, 0, 0.2),
      inset 0 0 8px rgba(255, 204, 0, 0.08);
    transition:
      background 0.15s,
      box-shadow 0.15s;
    text-align: center;

    &:hover {
      background: rgba(255, 204, 0, 0.18) !important;
      background-image: none !important;
      box-shadow:
        0 0 14px rgba(255, 204, 0, 0.55),
        0 0 4px rgba(255, 204, 0, 0.3),
        inset 0 0 12px rgba(255, 204, 0, 0.15);
    }

    &::after { display: none !important; }
  }

  /* ── CTF Timeline ── */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;

    &::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 2px;
      background: repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.22) 0px,
        rgba(255, 255, 255, 0.22) 5px,
        transparent 5px,
        transparent 10px
      );
    }
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.1rem 1rem;
    padding: 1rem 1rem 1rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    position: relative;

    /* dot — centered on the 2px line at left:0 */
    &::before {
      content: '';
      position: absolute;
      left: -3px;
      top: 50%;
      transform: translateY(-50%);
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(255, 204, 0, 0.65);
      box-shadow: 0 0 6px rgba(255, 204, 0, 0.45);
      z-index: 2;
      transition: background 0.2s, box-shadow 0.2s, transform 0.2s;
    }

    &:last-child {
      border-bottom: none;
    }

    &:hover {
      background: rgba(255, 204, 0, 0.05);
      box-shadow: inset -4px 0 0 rgba(255, 204, 0, 0.7),
        0 0 20px rgba(255, 204, 0, 0.06);
    }

    &:hover::before {
      background: #ffcc00;
      box-shadow: 0 0 0 2px rgba(255, 204, 0, 0.25), 0 0 12px rgba(255, 204, 0, 0.9);
      transform: translateY(-50%) scale(1.35);
    }
  }

  .timeline-body {
    min-width: 0;
  }

  .timeline-main {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    gap: 0.3rem 0.7rem;
    margin: 0 0 0.25rem;
    overflow: hidden;
  }

  .timeline-place {
    font-family: var(--font-primary);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #ffcc00;
    opacity: 0.9;
    text-transform: uppercase;
  }

  .timeline-name {
    font-size: clamp(18px, 2.4vw, 26px);
    font-weight: bold;
    text-transform: uppercase;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .timeline-tag {
    font-family: var(--font-primary);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.45);
    padding: 0.1em 0.4em;
    align-self: center;
  }

  .timeline-desc {
    font-family: var(--font-primary);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    opacity: 0.5;
    margin: 0 0 0.5rem;
    text-transform: uppercase;
  }

  .timeline-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
    margin-top: 0.4rem;
  }


  .timeline-year {
    font-family: var(--font-primary);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    opacity: 0.75;
    white-space: nowrap;
    text-align: right;
  }

  /* ── HTB Progress ── */
  .htb-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }

  .htb-status {
    font-family: var(--font-primary);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;

    & strong {
      color: #00ff88;
      text-shadow: 0 0 6px rgba(0, 255, 136, 0.4);
    }
  }

  .path-hint {
    font-family: var(--font-primary);
    font-size: 0.48rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.2);
    margin: 0 0 0.25rem;
  }

  /* ── Path Rows ── */
  .path-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .path-row {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    cursor: default;
    transition: background 0.15s;

    &:last-child {
      border-bottom: none;
    }

    &:hover {
      background: rgba(255, 204, 0, 0.04);
    }
  }

  .path-default {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0.9rem 0;
    flex-wrap: wrap;
  }

  .path-arrow {
    position: relative;
    width: 0.85rem;
    flex-shrink: 0;
    font-size: 0.85rem;
    line-height: 1;
  }

  .path-arrow__off {
    color: rgba(255, 255, 255, 0.28);
    transition: opacity 0.15s;
    opacity: 1;
    display: block;
  }

  .path-arrow__on {
    position: absolute;
    top: 0;
    left: 0;
    color: #ffcc00;
    text-shadow: 0 0 6px rgba(255, 204, 0, 0.6);
    opacity: 0;
    transition: opacity 0.15s;
  }

  .path-row:hover .path-arrow__off {
    opacity: 0;
  }

  .path-row:hover .path-arrow__on {
    opacity: 1;
  }

  .path-name {
    font-size: clamp(14px, 1.6vw, 17px);
    font-weight: bold;
    color: #fff;
    text-transform: uppercase;
    flex: 1;
    min-width: 0;
  }

  .path-status {
    font-family: var(--font-primary);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;

    &.--complete {
      color: #00ff88;
      text-shadow: 0 0 5px rgba(0, 255, 136, 0.35);
    }

    &.--progress {
      color: #ffcc00;
      opacity: 0.9;
    }
  }

  .path-bar-track {
    width: 8rem;
    height: 10px;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.15);
    position: relative;
    overflow: hidden;
    /* segmented overlay */
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        90deg,
        transparent 0px,
        transparent calc(10% - 1px),
        rgba(0, 0, 0, 0.55) calc(10% - 1px),
        rgba(0, 0, 0, 0.55) 10%
      );
      z-index: 2;
      pointer-events: none;
    }
  }

  .path-bar-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: var(--fill);
    background: #ffcc00;
    opacity: 0.85;
    z-index: 1;
  }

  @keyframes bar-load {
    from { width: 0%; }
    to   { width: var(--fill); }
  }

  .path-row:hover .path-bar-fill {
    animation: bar-load 0.6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  /* OSD details panel */
  .path-panel {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.2s ease, opacity 0.15s ease;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    background: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.015) 0px,
      rgba(255, 255, 255, 0.015) 1px,
      transparent 1px,
      transparent 3px
    );
    border-left: 2px solid rgba(255, 204, 0, 0.25);
    padding: 0 0 0 0.75rem;
  }

  .path-row:hover .path-panel {
    max-height: 8rem;
    opacity: 1;
    padding: 0.6rem 0 0.75rem 0.75rem;
  }

  .path-panel__line {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .pp-key {
    font-family: var(--font-primary);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 204, 0, 0.6);
    min-width: 5.5rem;
    flex-shrink: 0;
  }

  .pp-val {
    font-family: var(--font-primary);
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.65);
    text-transform: uppercase;
  }

  /* ── Mobile 768px ── */
  @media (max-width: 768px) {
    /* HUD: stack nav + date vertically so they don't overlap */
    .hud-strip {
      flex-direction: column;
      gap: 0.4rem;
      align-items: flex-start;
      padding: 0.5em 0.75em;
    }
    .hud-nav {
      position: static;
      transform: none;
      flex-wrap: wrap;
    }
    .hud-updated {
      margin-left: 0;
      text-align: left;
    }

    /* Shrink progress bar track so it fits on small screens */
    .path-bar-track { width: 5rem; }

    /* Touch toggle: show expanded panel when .is-open is set by JS */
    .path-row.is-open .path-panel {
      max-height: 12rem;
      opacity: 1;
      padding: 0.6rem 0 0.75rem 0.75rem;
    }
    .path-row.is-open .path-arrow__off { opacity: 0; }
    .path-row.is-open .path-arrow__on  { opacity: 1; }
    .path-row.is-open .path-bar-fill {
      animation: bar-load 0.6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    /* On touch devices, swap hint text to "TAP PATH FOR DETAILS" */
    @media (hover: none) {
      .path-hint { font-size: 0; letter-spacing: 0; }
      .path-hint::after {
        content: '// TAP PATH FOR DETAILS';
        font-size: clamp(0.45rem, 1.3vw, 0.55rem);
        letter-spacing: 0.08em;
        color: rgba(255, 204, 0, 0.35);
        font-family: var(--font-primary);
        text-transform: uppercase;
      }
    }

    /* Timeline: single column so year doesn't get squashed */
    .timeline-item {
      grid-template-columns: 1fr;
    }
    .timeline-year {
      text-align: left;
      margin-top: 0.2rem;
    }
  }

  /* ── Mobile 580px ── */
  @media (max-width: 580px) {
    .hud-strip {
      font-size: 0.55rem;
    }

    .hero-card__left {
      padding-right: 0;
    }

    .hero-card__corner {
      position: static;
      flex-direction: row-reverse;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.75rem;
    }

    .page-title {
      font-size: clamp(20px, 6vw, 32px);
    }
  }
</style>

<script>
  function initHudScroll() {
    const strip = document.querySelector('.hud-strip')
    if (!strip) return

    strip.addEventListener('click', (e) => {
      const link = e.target?.closest?.('.hud-link')
      if (!link) return

      const scrollRoot = document.querySelector('.tv-content')
      if (!scrollRoot) return

      const targetId = link.dataset.target
      if (!targetId) return

      const target = document.querySelector(targetId)
      if (!target) return

      const hudH = strip.offsetHeight
      const rootRect = scrollRoot.getBoundingClientRect()
      const targetRect = target.getBoundingClientRect()
      const offsetTop =
        scrollRoot.scrollTop + (targetRect.top - rootRect.top) - hudH - 16

      scrollRoot.scrollTo({ top: Math.max(0, offsetTop), behavior: 'smooth' })
    })
  }

  // Touch toggle for HTB path panels (on desktop these open on hover only)
  function initPathTouch() {
    document.querySelectorAll('.path-row').forEach((row) => {
      row.addEventListener('click', () => {
        if (!window.matchMedia('(hover: hover)').matches) {
          row.classList.toggle('is-open')
        }
      })
    })
  }

  initHudScroll()
  initPathTouch()
  document.addEventListener('astro:page-load', () => {
    initHudScroll()
    initPathTouch()
  })
</script>
