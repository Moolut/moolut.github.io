    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 204, 0, 0.6);
    min-width: 5.5rem;
    flex-shrink: 0;
  }

  .pp-val {
    font-family: var(--font-primary);
    font-size: 0.55rem;
