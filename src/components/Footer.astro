---
import SpaceTrigger from './SpaceTrigger.svelte'
---

<footer class="footer" id="footer">
  <div class="footer__bottom">
    <ul class="link-list">
      <li>
        <a href="/resume" rel="noopener noreferrer" target="_blank">RESUME</a>
      </li>
      <li>
        <a
          href="mailto:yldrmm.mevlut@gmail.com"
          rel="noopener noreferrer"
          target="_blank"
        >
          EMAIL
        </a>
      </li>
      <li>
        <a
          href="https://linkedin.com/in/mevlut-yildirim"
          rel="noopener noreferrer"
          target="_blank"
        >
          LINKEDIN
        </a>
      </li>
      <li>
        <a
          href="https://github.com/moolut"
          rel="noopener noreferrer"
          target="_blank"
        >
          GITHUB
        </a>
      </li>
    </ul>
    <div class="footer__space">
      <SpaceTrigger client:load />
    </div>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: 48px;
    padding-bottom: var(--gui-bottom);
    gap: 1rem;
  }

  .footer::before {
    content: '';
    display: block;
    width: 60%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.25) 20%,
      rgba(255, 255, 255, 0.25) 80%,
      transparent 100%
    );
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
  }

  .link-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .footer__space {
    position: absolute;
    right: 0;
  }

  @media (max-width: 600px) {
    .footer__bottom {
      flex-direction: column;
      gap: 1rem;
    }

    .footer__space {
      position: static;
    }
  }
</style>
